# Production environment template for Ripplebox API.
# Copy to .env on the production host and fill in every REPLACE_* value.
# Never commit the real .env — it's already gitignored.

APP_NAME=Ripplebox
APP_ENV=production
APP_KEY=REPLACE_RUN_php_artisan_key:generate
APP_DEBUG=false
APP_URL=https://api.ripplebox.com.au

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# AWS RDS MySQL 8.0, per the assessment report's architecture (Section 3.1).
DB_CONNECTION=mysql
DB_HOST=REPLACE_RDS_ENDPOINT
DB_PORT=3306
DB_DATABASE=ripplebox
DB_USERNAME=REPLACE_DB_USERNAME
DB_PASSWORD=REPLACE_DB_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=s3

# Real SMS delivery for OTP codes — currently only logged (see
# OtpAuthController::request). AWS SNS per the assessment report;
# Twilio is a drop-in alternative if preferred.
AWS_ACCESS_KEY_ID=REPLACE_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_AWS_SECRET_ACCESS_KEY
AWS_DEFAULT_REGION=ap-southeast-2
AWS_BUCKET=REPLACE_S3_BUCKET_NAME

# Real transactional email delivery — currently MAIL_MAILER=log, so
# nothing is actually sent. Postmark/SES/Resend are all one-line swaps
# since WelcomeSalonMail/RewardEarnedMail/RegistrationMail already use
# Laravel's Mail facade.
MAIL_MAILER=REPLACE_ses_or_postmark_or_resend
MAIL_FROM_ADDRESS="hello@ripplebox.com.au"
MAIL_FROM_NAME="${APP_NAME}"

# Real Stripe keys — the payment screen is currently a UI mock only,
# no charge has ever been processed. See SubscriptionController.
STRIPE_KEY=REPLACE_STRIPE_PUBLISHABLE_KEY
STRIPE_SECRET=REPLACE_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=REPLACE_STRIPE_WEBHOOK_SECRET

# Firebase Cloud Messaging — push notifications are currently in-app/DB
# only (NotificationController), no push is actually delivered (FR-11).
FIREBASE_CREDENTIALS=REPLACE_PATH_TO_SERVICE_ACCOUNT_JSON
FIREBASE_PROJECT_ID=REPLACE_FIREBASE_PROJECT_ID

# Google Places API — salon discovery currently lists salons by name only,
# with no live location/distance search (FR-12).
GOOGLE_PLACES_API_KEY=REPLACE_GOOGLE_PLACES_API_KEY

# Shared secret the marketing website's salon-signup webhook signs with
# (FR-15) — generate a real random value, do not reuse the dev default.
WEBSITE_WEBHOOK_SECRET=REPLACE_RUN_openssl_rand_-hex_32

# Where the mobile app / web build lives — used for real links in
# transactional emails.
FRONTEND_URL=https://app.ripplebox.com.au

# Apple/Google reviewers can't receive a real SMS, so this one number gets
# a fixed, known code instead — hand these two values to the reviewer via
# the App Store Connect / Play Console demo-account fields, never surface
# them in the app itself. Leave unset outside of a review submission if
# you'd rather not have a standing bypass number. Already submitted to
# Apple/Google — do not change or reuse this number for anything else.
APP_REVIEW_PHONE_NUMBER=+61400000199
APP_REVIEW_OTP_CODE=681146

# A second, separate bypass number for the team's own demo/testing use —
# e.g. trying the salon-owner sign-up flow, since the app-review number
# above is permanently a client account. Free to change or rotate.
DEMO_SALON_PHONE_NUMBER=+61400000299
DEMO_SALON_OTP_CODE=924817
